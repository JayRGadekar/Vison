{
  "name": "vison",
  "private": true,
  "version": "0.1.0",
  "description": "Local image and video generation",
  "author": "Jay",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:electron": "vite build && electron .",
    "package": "npm run build",
    "check:ffmpeg": "node scripts/check-ffmpeg-license.cjs",
    "licenses": "node scripts/collect-licenses.cjs",
    "test:chats": "node electron/chat-store.test.mjs",
    "test:titles": "node src/conversation-title.test.mjs",
    "test": "npm run test:chats && npm run test:titles"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-electron": "^0.29.1"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.vison.app",
    "productName": "Vison",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "../build/bin",
        "to": "backend",
        "filter": [
          "vison_server.exe",
          "*.dll",
          "ffmpeg.exe",
          "ffmpeg"
        ]
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "./scripts/check-ffmpeg-license.cjs"
  }
}
