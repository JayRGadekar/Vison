# Copy this file to .env.local (already gitignored, so it stays out of git)
# and fill in both values, or set them as real environment variables instead
# - either way works identically. See docs/OAUTH-SETUP.md.
#
# Both optional: leave them blank (or omit .env.local entirely) to build
# Vison without Google sign-in - everything else still works.

VISON_GOOGLE_CLIENT_ID=
VISON_GOOGLE_CLIENT_SECRET=
