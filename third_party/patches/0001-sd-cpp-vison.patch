diff --git a/src/core/ggml_extend.hpp b/src/core/ggml_extend.hpp
index d14d287..c6bd13b 100644
--- a/src/core/ggml_extend.hpp
+++ b/src/core/ggml_extend.hpp
@@ -2408,6 +2408,8 @@ protected:
         GGML_ASSERT(gf != nullptr);
 
         size_t effective_budget = max_graph_vram_bytes;
+        // VLLAMA LOCAL PATCH (see PATCHES.md): `budget_clamped` is new.
+        bool budget_clamped = false;
         if (stream_layers_enabled && max_graph_vram_bytes > 0 && runtime_backend != nullptr) {
             ggml_backend_dev_t dev = ggml_backend_get_device(runtime_backend);
             if (dev != nullptr && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
@@ -2421,6 +2423,7 @@ protected:
                               free_clamp / (1024.0 * 1024.0),
                               effective_budget / (1024.0 * 1024.0));
                     effective_budget = free_clamp;
+                    budget_clamped   = true;
                 }
             }
         }
@@ -2430,6 +2433,30 @@ protected:
             if (effective_budget > observed_max_effective_budget_) {
                 observed_max_effective_budget_ = effective_budget;
                 budget_increased               = true;
+            } else if (budget_clamped) {
+                // VLLAMA LOCAL PATCH (see PATCHES.md).
+                //
+                // Upstream restores observed_max_effective_budget_ here
+                // unconditionally, which makes the budget monotonically
+                // non-decreasing and silently discards the clamp computed
+                // above. The log shows the damage plainly:
+                //
+                //   clamping streaming budget: actual free VRAM 2290MB < user cap 4096MB
+                //   streaming budget = 4096.00 MB
+                //
+                // A budget larger than free VRAM makes annotate_residency()
+                // promote more segments to RESIDENT than the card can hold.
+                // The allocation then fails inside ggml and aborts the process
+                // outright - not a C++ exception, so nothing upstream of here
+                // can catch it.
+                //
+                // The high-water mark exists to stop the budget oscillating on
+                // noisy per-graph VRAM readings and thrashing the plan cache,
+                // which is worth keeping. But it must not override a clamp that
+                // reflects real memory pressure: down is the direction that
+                // prevents the OOM. So when the clamp fires, honour it and pull
+                // the high-water mark down to match.
+                observed_max_effective_budget_ = effective_budget;
             } else {
                 effective_budget = observed_max_effective_budget_;
             }
